@{
    Layout = "_Layout";
    ViewData["Title"] = "الطرح";
    ViewData["FullWidth"] = "1";
    ViewData["HasSidebar"] = "1";
}

<div class="dashboard-layout home-shell">
    <aside class="sidebar-nav scope-nav">
        <div class="sidebar-nav-title">
            <span>لوحة التنقّل</span>
            <button class="nav-close" id="navClose" type="button" aria-label="إغلاق القائمة"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="sidebar-scroll">
            <partial name="_PageNavSidebar" />
        </div>
    </aside>

    <section class="dashboard-content">
        <div class="nav-bar-row print-hide">
            <a href="@Url.Action("Index", "Home")" class="back-btn"
               onclick="if(document.referrer && document.referrer.indexOf(location.origin)===0){history.back();return false;}">
                @Icons.Svg("back", "btn-svg") <span>رجوع</span>
            </a>
            <div class="breadcrumb-bar">
                <a href="@Url.Action("Index", "Home")">الرئيسية</a>
                <span>/</span>
                <span>الطرح</span>
            </div>
        </div>

        <div class="dash-header-row print-hide">
            <div class="dash-header-info">
                <div class="dash-icon-badge">@Icons.Svg("trending", "")</div>
                <div>
                    <div class="page-title" style="margin-bottom:0;">الطرح</div>
                    <div class="page-subtitle" style="margin-bottom:0;">عقود الطرح - حسب النوع والإدارة العامة وحالة الإبرام</div>
                </div>
            </div>
            <div class="tc-upload-wrap read-only-hide">
                <input type="file" id="tarhUploadInput" accept=".xlsx" hidden />
                <button type="button" id="tarhUploadBtn" class="tc-upload-btn">
                    <i class="bi bi-upload"></i>
                    <span>رفع ملف الطرح</span>
                </button>
                <span id="tarhUploadStatus" class="tc-upload-status"></span>
            </div>
        </div>

        <!-- رأس خاص بالطباعة فقط (مخفي على الشاشة) -->
        <div class="contract-print-header">
            <div class="contract-print-logo-row">
                <span>أمانة منطقة المدينة المنورة - عقود الطرح</span>
            </div>
            <div class="contract-print-title">تقرير عقود الطرح</div>
            <div class="contract-print-date">تاريخ الطباعة: <span id="tarhPrintDate"></span></div>
        </div>

        <div id="tarhFilterBar" class="dash-filter-bar print-hide" style="margin-bottom:14px;"></div>

        <div class="contract-actions print-hide" style="margin-bottom:14px;">
            <button type="button" class="contract-action-btn" id="tarhExportExcelBtn">
                @Icons.Svg("excel", "") <span>تصدير Excel</span>
            </button>
            <button type="button" class="contract-action-btn" id="tarhExportPdfBtn">
                @Icons.Svg("pdf", "") <span>طباعة PDF</span>
            </button>
        </div>

        <div id="tarhContent">
            <div class="tarh-kpi-grid print-hide" id="tarhKpiGrid"></div>

            <div class="charts-grid-3 tarh-envelope-row print-hide" style="margin-bottom:18px;">
                <div class="chart-card" id="tarhEnvelopeOpenedCard">
                    <div class="chart-header">
                        <div>
                            <div class="chart-title"><i class="bi bi-envelope-open"></i> الفرص التي فُتحت مظاريفها</div>
                            <div class="chart-subtitle" id="tarhEnvelopeOpenedSubtitle"></div>
                        </div>
                        <div class="rp-toggle-group" id="tarhEnvelopeOpenedTabs">
                            <button type="button" class="rp-toggle-btn active" data-range="week">الأسبوع القادم</button>
                            <button type="button" class="rp-toggle-btn" data-range="month">الشهر القادم</button>
                            <button type="button" class="rp-toggle-btn" data-range="year2026">عام 2026</button>
                        </div>
                    </div>
                    <div id="tarhEnvelopeOpenedList"></div>
                </div>
                <div id="tarhUpcomingTendersSlot"></div>
            </div>

            <div class="charts-grid-3 print-hide" id="tarhChartsRow1" style="margin-bottom:18px;"></div>
            <div class="charts-grid-3 tarh-duration-row print-hide" id="tarhChartsRow3" style="margin-bottom:18px;"></div>

            <div class="charts-grid-3 tc-row-single print-hide" id="tarhChartsRow4" style="margin-bottom:18px;"></div>
            <div class="charts-grid-3 tc-row-single print-hide" id="tarhChartsRow5"></div>

            <!-- جدول التصدير: مخفي على الشاشة، يظهر عند الطباعة فقط -->
            <div class="contract-table-wrap tarh-export-table-wrap" id="tarhExportTableWrap">
                <table class="contract-table with-number">
                    <thead>
                        <tr>
                            <th>رقم الفرصة</th><th>رقم العقد</th><th>اسم الفرصة</th><th>القيمة</th>
                            <th>الإدارة العامة</th><th>المحفظة الفرعية</th><th>سنة الطرح</th><th>تاريخ العقد</th>
                        </tr>
                    </thead>
                    <tbody id="tarhExportTableBody"></tbody>
                </table>
            </div>
        </div>

        <div class="no-data-box print-hide" id="tarhNoDataBox" style="display:none;">
            <span class="nd-icon">@Icons.Svg("inbox", "")</span>
            لا توجد بيانات عقود مستوردة بعد. اضغط "رفع ملف الطرح" أعلى الصفحة للبدء.
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.5.1/dist/echarts.min.js"></script>
    <script>
        window.TARH_DATA_URL = "@Url.Action("TarhData", "Claims")";
        window.TARH_UPLOAD_URL = "@Url.Action("UploadContracts", "Claims")";
        window.TARH_EXPORT_DATA_URL = "@Url.Action("TarhExportData", "Claims")";
        window.TARH_EXPORT_EXCEL_URL = "@Url.Action("TarhExportExcel", "Claims")";
        window.TARH_OPPORTUNITY_OPTIONS_URL = "@Url.Action("TarhOpportunityOptions", "Claims")";
        window.TARH_OPPORTUNITY_TIMELINE_URL = "@Url.Action("TarhOpportunityTimeline", "Claims")";
        window.TARH_ENVELOPE_OPENED_URL = "@Url.Action("TarhEnvelopeOpenedData", "Claims")";
    </script>
    <script src="~/js/tarh.js" asp-append-version="true"></script>
}
