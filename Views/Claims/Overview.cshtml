@{
    Layout = "_Layout";
    ViewData["Title"] = "المطالبات والمديونيات";
    ViewData["FullWidth"] = "1";
    ViewData["HasSidebar"] = "1";
}

<div class="dashboard-layout home-shell">
    <aside class="sidebar-nav scope-nav">
        <div class="sidebar-nav-title">
            <span>لوحة التنقّل</span>
            <button class="nav-close" id="navClose" type="button" aria-label="إغلاق القائمة"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="sidebar-scroll">
            <partial name="_PageNavSidebar" />
        </div>
    </aside>

    <section class="dashboard-content">
        <div class="nav-bar-row">
            <a href="@Url.Action("Index", "Home")" class="back-btn"
               onclick="if(document.referrer && document.referrer.indexOf(location.origin)===0){history.back();return false;}">
                @Icons.Svg("back", "btn-svg") <span>رجوع</span>
            </a>
            <div class="breadcrumb-bar">
                <a href="@Url.Action("Index", "Home")">الرئيسية</a>
                <span>/</span>
                <span>المطالبات والمديونيات</span>
            </div>
        </div>

        <div class="dash-header-row">
            <div class="dash-header-info">
                <div class="dash-icon-badge">@Icons.Svg("report", "")</div>
                <div>
                    <div class="page-title" style="margin-bottom:0;">المطالبات والمديونيات</div>
                    <div class="page-subtitle" style="margin-bottom:0;">ملخص عام عن المطالبات والمديونيات المستوردة من ملف Excel</div>
                </div>
            </div>
            <a href="@Url.Action("Upload", "Claims")" class="tc-upload-btn">
                @Icons.Svg("upload", "") <span>رفع ملف Excel</span>
            </a>
        </div>

        <div id="claimsOverviewContent">
            <div class="revenue-kpis" id="cdHeroKpis"></div>

            <div class="charts-grid-3 tc-row-single" id="cdDebtStatusRow" style="margin-bottom:12px;"></div>
            <div class="charts-grid-3" id="cdHistogramRow" style="margin-bottom:12px;"></div>
            <div class="charts-grid-3 tc-row-single" id="cdClaimStatusRow" style="margin-bottom:12px;"></div>
            <div class="charts-grid-3 tc-row-single" id="cdClaimPercentRow"></div>
        </div>

        <div class="no-data-box" id="cdNoDataBox" style="display:none;">
            <span class="nd-icon">@Icons.Svg("inbox", "")</span>
            لا توجد بيانات مطالبات أو مديونيات مستوردة بعد. اضغط "رفع ملف Excel" أعلى الصفحة للبدء.
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.5.1/dist/echarts.min.js"></script>
    <script>
        window.CD_OVERVIEW_DATA_URL = "@Url.Action("OverviewData", "Claims")";
    </script>
    <script src="~/js/claims-overview.js" asp-append-version="true"></script>
}
