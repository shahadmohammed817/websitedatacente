<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - لوحة بيانات أمانة منطقة المدينة المنورة</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=Cairo:wght@600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
@{
    // الصفحات ذات القائمة الجانبية (الرئيسية) تأخذ عرضًا كاملاً لتلتصق القائمة باليمين،
    // وبقية الصفحات تُوسَّط في المنتصف.
    var widthClass = (ViewData["FullWidth"] as string) == "1" ? "layout-full" : "layout-centered";
    // هل تحتوي الصفحة على قائمة جانبية؟ (الرئيسية) — لإظهار زر القائمة على الجوال
    var hasSidebar = (ViewData["HasSidebar"] as string) == "1";
    // تحديد الرابط النشط في شريط التنقّل العلوي حسب المتحكم/الإجراء الحالي
    var currentController = ViewContext.RouteData.Values["controller"] as string ?? "";
    var currentAction = ViewContext.RouteData.Values["action"] as string ?? "";
    var currentScope = Context.Request.Query["scope"].ToString();
    Func<string, string, string, string> navActive = (ctrl, action, scope) =>
    {
        bool match = string.Equals(currentController, ctrl, StringComparison.OrdinalIgnoreCase)
                  && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
                  && (scope == "" || string.Equals(currentScope, scope, StringComparison.OrdinalIgnoreCase));
        return match ? "top-nav-link active" : "top-nav-link";
    };
}
<body class="@(ExcelDashboard.Helpers.AppMode.ReadOnly ? "read-only-mode" : "")">
    <header class="top-bar">
        <div class="top-bar-inner @widthClass">
            <a href="@Url.Action("Index", "Home")" class="brand">
                <img src="~/images/logo.png" alt="أمانة منطقة المدينة المنورة" class="brand-logo" />
            </a>

            @if (hasSidebar)
            {
                <button class="nav-toggle" id="navToggle" type="button" aria-label="فتح قائمة التنقّل" aria-expanded="false">
                    <i class="bi bi-list"></i>
                </button>
            }
        </div>
    </header>

    @if (hasSidebar)
    {
        <div class="nav-overlay" id="navOverlay"></div>
    }

    <main class="main-authenticated @widthClass">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <span>© @DateTime.Now.Year أمانة منطقة المدينة المنورة — جميع الحقوق محفوظة</span>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @if (hasSidebar)
    {
        <script>
            (function () {
                var toggle = document.getElementById('navToggle');
                var overlay = document.getElementById('navOverlay');
                var closeBtn = document.getElementById('navClose');
                if (!toggle) return;

                function openNav() { document.body.classList.add('nav-open'); toggle.setAttribute('aria-expanded', 'true'); }
                function closeNav() { document.body.classList.remove('nav-open'); toggle.setAttribute('aria-expanded', 'false'); }

                toggle.addEventListener('click', function () {
                    document.body.classList.contains('nav-open') ? closeNav() : openNav();
                });
                if (overlay) overlay.addEventListener('click', closeNav);
                if (closeBtn) closeBtn.addEventListener('click', closeNav);
                document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeNav(); });

                // إغلاق الدرج تلقائيًا عند اختيار أي عنصر من القائمة (على الجوال)
                document.querySelectorAll('.home-shell .sidebar-link, .home-shell .sidebar-upload-btn').forEach(function (link) {
                    link.addEventListener('click', function () {
                        if (window.matchMedia('(max-width: 900px)').matches) closeNav();
                    });
                });
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
