@{
    Layout = "_Layout";
    ViewData["Title"] = "الأنشطة الاستثمارية";
    ViewData["FullWidth"] = "1";
    ViewData["HasSidebar"] = "1";
}

<div class="dashboard-layout home-shell">
    <aside class="sidebar-nav scope-nav">
        <div class="sidebar-nav-title">
            <span>لوحة التنقّل</span>
            <button class="nav-close" id="navClose" type="button" aria-label="إغلاق القائمة"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="sidebar-scroll">
            <partial name="_PageNavSidebar" />
        </div>
    </aside>

    <section class="dashboard-content">
        <div class="nav-bar-row">
            <a href="@Url.Action("Index", "Home")" class="back-btn"
               onclick="if(document.referrer && document.referrer.indexOf(location.origin)===0){history.back();return false;}">
                @Icons.Svg("back", "btn-svg") <span>رجوع</span>
            </a>
            <div class="breadcrumb-bar">
                <a href="@Url.Action("Index", "Home")">الرئيسية</a>
                <span>/</span>
                <span>الأنشطة الاستثمارية</span>
            </div>
        </div>

        <div class="dash-header-row">
            <div class="dash-header-info">
                <div class="dash-icon-badge">@Icons.Svg("globe", "")</div>
                <div>
                    <div class="page-title" style="margin-bottom:0;">الأنشطة الاستثمارية</div>
                    <div class="page-subtitle" style="margin-bottom:0;">الأجرة السنوية والعقود حسب المنطقة والقطاع، وموقعها على الخريطة</div>
                </div>
            </div>
            <div class="contract-actions read-only-hide" style="margin-bottom:0;">
                <div class="tc-upload-wrap">
                    <input type="file" id="actUploadInput" accept=".xlsx" hidden />
                    <button type="button" id="actUploadBtn" class="tc-upload-btn">
                        <i class="bi bi-upload"></i>
                        <span>رفع ملف الأنشطة</span>
                    </button>
                    <span id="actUploadStatus" class="tc-upload-status"></span>
                </div>
            </div>
        </div>

        <div id="actFilterBar" class="dash-filter-bar" style="margin-bottom:14px;"></div>

        <div id="actContent">
            <div class="tarh-kpi-grid" id="actKpiGrid"></div>

            <div class="charts-grid-3 tc-row-single" id="actChartsRow1a" style="margin-bottom:18px;"></div>
            <div class="charts-grid-3 tc-row-single" id="actChartsRow2" style="margin-bottom:18px;"></div>

            <div id="actTopContractCard" style="margin-bottom:18px;"></div>

            <div class="chart-card" id="actMapCard">
                <div class="chart-header">
                    <div class="chart-title">مواقع الفرص على الخريطة</div>
                    <div class="chart-badge">مرّري الماوس فوق أي علامة</div>
                </div>
                <div id="actMapBox" style="height:520px;border-radius:12px;overflow:hidden;"></div>
            </div>
        </div>

        <div class="no-data-box" id="actNoDataBox" style="display:none;">
            <span class="nd-icon">@Icons.Svg("inbox", "")</span>
            لا توجد بيانات أنشطة استثمارية مستوردة بعد. اضغط "رفع ملف الأنشطة" أعلى الصفحة للبدء.
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.5.1/dist/echarts.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
    <script src="https://cdn.jsdelivr.net/npm/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
    <script>
        window.ACT_DATA_URL = "@Url.Action("Data", "InvestmentActivities")";
        window.ACT_UPLOAD_URL = "@Url.Action("Upload", "InvestmentActivities")";
    </script>
    <script src="~/js/investment-activities.js" asp-append-version="true"></script>
}
